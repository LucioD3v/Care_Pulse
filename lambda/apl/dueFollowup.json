{
  "type": "APL",
  "version": "1.7",
  "theme": "dark",
  "background": "#102F62",
  "import": [
    { "name": "alexa-viewport-profiles", "version": "1.6.0" }
  ],
  "mainTemplate": {
    "parameters": ["followupData"],
    "items": [
      {
        "type": "Pager",
        "id": "dueFollowupPager",
        "width": "100vw",
        "height": "100vh",
        "initialPage": 0,
        "navigation": "none",
        "onMount": [
          {
            "type": "AutoPage",
            "componentId": "dueFollowupPager",
            "count": 1,
            "delay": 5000,
            "duration": 0,
            "screenLock": true
          }
        ],
        "handlePageMove": [
          {
            "when": "${event.direction == 'left' || event.direction == 'right'}",
            "drawOrder": "nextAbove",
            "commands": [
              {
                "type": "SetValue",
                "componentId": "${event.currentChild.uid}",
                "property": "opacity",
                "value": "${1 - event.amount}"
              },
              {
                "type": "SetValue",
                "componentId": "${event.nextChild.uid}",
                "property": "opacity",
                "value": "${event.amount}"
              },
              {
                "type": "SetValue",
                "componentId": "${event.nextChild.uid}",
                "property": "transform",
                "value": [{ "translateX": "${24 * (1 - event.amount)}dp" }]
              }
            ]
          }
        ],
        "items": [
          {
            "type": "Image",
            "width": "100vw",
            "height": "100vh",
            "source": "${followupData.coverImageUrl}",
            "scale": "best-fill",
            "align": "center",
            "accessibilityLabel": "CarePulse cover"
          },
          {
            "type": "Container",
            "width": "100vw",
            "height": "100vh",
            "items": [
              {
                "type": "Image",
                "position": "absolute",
                "width": "100vw",
                "height": "100vh",
                "source": "${followupData.backgroundImageUrl}",
                "scale": "best-fill",
                "align": "center",
                "accessibilityLabel": "CarePulse wellness journey background"
              },
              {
                "type": "Frame",
                "position": "absolute",
                "width": "100vw",
                "height": "100vh",
                "backgroundColor": "rgba(4, 20, 54, 0.16)"
              },
              {
                "type": "Container",
                "width": "${@viewportProfile == @hubLandscapeSmall ? '82vw' : '70vw'}",
                "height": "100vh",
                "paddingLeft": "${@viewportProfile == @hubLandscapeSmall ? '24dp' : '64dp'}",
                "paddingRight": "${@viewportProfile == @hubLandscapeSmall ? '20dp' : '40dp'}",
                "paddingTop": "${@viewportProfile == @hubLandscapeSmall ? '22dp' : '54dp'}",
                "paddingBottom": "${@viewportProfile == @hubLandscapeSmall ? '20dp' : '44dp'}",
                "justifyContent": "center",
                "items": [
                  {
                    "type": "Frame",
                    "width": "100%",
                    "backgroundColor": "rgba(8, 30, 72, 0.88)",
                    "borderColor": "rgba(190, 241, 231, 0.52)",
                    "borderWidth": "1dp",
                    "borderRadius": "30dp",
                    "paddingLeft": "${@viewportProfile == @hubLandscapeSmall ? '24dp' : '40dp'}",
                    "paddingRight": "${@viewportProfile == @hubLandscapeSmall ? '24dp' : '40dp'}",
                    "paddingTop": "${@viewportProfile == @hubLandscapeSmall ? '22dp' : '34dp'}",
                    "paddingBottom": "${@viewportProfile == @hubLandscapeSmall ? '22dp' : '34dp'}",
                    "item": {
                      "type": "Container",
                      "items": [
                        {
                          "type": "Text",
                          "text": "CARE<span color='#B9F5E5'>PULSE</span>  •  FOLLOW-UP",
                          "fontSize": "${@viewportProfile == @hubLandscapeSmall ? '14dp' : '17dp'}",
                          "fontWeight": "700",
                          "color": "#FFFFFF",
                          "letterSpacing": "1.2dp"
                        },
                        {
                          "type": "Text",
                          "text": "${followupData.question}",
                          "fontSize": "${@viewportProfile == @hubLandscapeSmall ? '28dp' : '42dp'}",
                          "fontWeight": "700",
                          "color": "#FFFFFF",
                          "maxLines": 3,
                          "paddingTop": "12dp",
                          "paddingBottom": "${@viewportProfile == @hubLandscapeSmall ? '18dp' : '28dp'}"
                        },
                        {
                          "type": "Container",
                          "direction": "row",
                          "width": "100%",
                          "justifyContent": "spaceBetween",
                          "items": [
                            {
                              "type": "TouchWrapper",
                              "id": "followupBetterButton",
                              "role": "button",
                              "accessibilityLabel": "Better",
                              "width": "31%",
                              "onPress": [{
                                "type": "SendEvent",
                                "arguments": ["complete-due-followup", "better"]
                              }],
                              "item": {
                                "type": "Frame",
                                "height": "${@viewportProfile == @hubLandscapeSmall ? '70dp' : '88dp'}",
                                "borderRadius": "20dp",
                                "backgroundColor": "#DFFFF3",
                                "borderColor": "#91DACB",
                                "borderWidth": "2dp",
                                "item": {
                                  "type": "Container",
                                  "height": "100%",
                                  "alignItems": "center",
                                  "justifyContent": "center",
                                  "items": [
                                    { "type": "Text", "text": "Better", "fontSize": "${@viewportProfile == @hubLandscapeSmall ? '21dp' : '27dp'}", "fontWeight": "700", "color": "#123C63" },
                                    { "type": "Text", "text": "Feeling improved", "fontSize": "13dp", "color": "#315D77" }
                                  ]
                                }
                              }
                            },
                            {
                              "type": "TouchWrapper",
                              "id": "followupSameButton",
                              "role": "button",
                              "accessibilityLabel": "The same",
                              "width": "31%",
                              "onPress": [{
                                "type": "SendEvent",
                                "arguments": ["complete-due-followup", "same"]
                              }],
                              "item": {
                                "type": "Frame",
                                "height": "${@viewportProfile == @hubLandscapeSmall ? '70dp' : '88dp'}",
                                "borderRadius": "20dp",
                                "backgroundColor": "rgba(226, 213, 255, 0.22)",
                                "borderColor": "#CEB8F6",
                                "borderWidth": "2dp",
                                "item": {
                                  "type": "Container",
                                  "height": "100%",
                                  "alignItems": "center",
                                  "justifyContent": "center",
                                  "items": [
                                    { "type": "Text", "text": "The same", "fontSize": "${@viewportProfile == @hubLandscapeSmall ? '21dp' : '27dp'}", "fontWeight": "700", "color": "#FFFFFF" },
                                    { "type": "Text", "text": "No change", "fontSize": "13dp", "color": "#DDEEF3" }
                                  ]
                                }
                              }
                            },
                            {
                              "type": "TouchWrapper",
                              "id": "followupWorseButton",
                              "role": "button",
                              "accessibilityLabel": "Worse",
                              "width": "31%",
                              "onPress": [{
                                "type": "SendEvent",
                                "arguments": ["complete-due-followup", "worse"]
                              }],
                              "item": {
                                "type": "Frame",
                                "height": "${@viewportProfile == @hubLandscapeSmall ? '70dp' : '88dp'}",
                                "borderRadius": "20dp",
                                "backgroundColor": "rgba(255, 218, 218, 0.20)",
                                "borderColor": "#F0B8C0",
                                "borderWidth": "2dp",
                                "item": {
                                  "type": "Container",
                                  "height": "100%",
                                  "alignItems": "center",
                                  "justifyContent": "center",
                                  "items": [
                                    { "type": "Text", "text": "Worse", "fontSize": "${@viewportProfile == @hubLandscapeSmall ? '21dp' : '27dp'}", "fontWeight": "700", "color": "#FFFFFF" },
                                    { "type": "Text", "text": "Feeling worse", "fontSize": "13dp", "color": "#F8DDE1" }
                                  ]
                                }
                              }
                            }
                          ]
                        },
                        {
                          "type": "Text",
                          "text": "Tap an option or answer by voice.",
                          "fontSize": "${@viewportProfile == @hubLandscapeSmall ? '13dp' : '16dp'}",
                          "color": "#BCD7E2",
                          "paddingTop": "14dp"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
