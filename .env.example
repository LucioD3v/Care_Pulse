# Keep 4.14.0 to run the final unauthenticated Community image.
LOCALSTACK_IMAGE=localstack/localstack:4.14.0
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0
LAMBDA_RUNTIME_IMAGE=amazon/aws-lambda-nodejs:20
LAMBDA_RUNTIME_ENVIRONMENT_TIMEOUT=60

# Serverless deployment configuration. Copy this file to .env and replace the
# placeholders. Never commit .env because CAREPULSE_MCP_KEY is a secret.
CAREPULSE_ALEXA_SKILL_ID=
CAREPULSE_REPORT_BACKGROUND_URL=
CAREPULSE_HOME_BACKGROUND_URL=
CAREPULSE_FOLLOWUP_COMPLETE_BACKGROUND_URL=
CAREPULSE_PERMISSION_BACKGROUND_URL=
CAREPULSE_BEDROCK_MODEL_ID=
BEDROCK_RESOURCE_ARNS=
VOICE_TIMEOUT_MS=1200
CAREPULSE_MCP_KEY=
