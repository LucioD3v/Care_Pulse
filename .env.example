# Keep 4.14.0 to run the final unauthenticated Community image.
LOCALSTACK_IMAGE=localstack/localstack:4.14.0
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0
LAMBDA_RUNTIME_IMAGE=amazon/aws-lambda-nodejs:20
LAMBDA_RUNTIME_ENVIRONMENT_TIMEOUT=60

# AWS deployment settings. See docs/environment-configuration.md for accepted values,
# defaults, required settings, and the difference between local and deployed use.
# Serverless v4 reads .env and .env.<stage>; deploy with an explicit --stage.
# Existing --param values take precedence over these deployment variables.
AWS_REGION=us-east-1
# Supported deployment modes: demo or production. Serverless defaults to demo if omitted.
# Demo is forbidden when STAGE is prod or production. Production setup is not complete.
CARE_MODE=demo
# Optional and local-only: memory is the sole recognized enabling value.
# It works only with CARE_MODE=demo, no CARE_TABLE_NAME, and outside AWS Lambda.
# Omit this variable for deployed functions; Serverless does not forward it.
CARE_STORAGE_MODE=memory
# Optional integer from 1 to 365; default 90.
WELLNESS_RETENTION_DAYS=90

# Required: replace the empty values before packaging or deploying.
# These were already deployment parameters; no real IDs or keys were embedded in serverless.yml.
ALEXA_SKILL_ID=
MCP_API_KEY=
# CAREPULSE_MCP_KEY is also accepted if MCP_API_KEY is not defined.
# Remove the MCP_API_KEY= line if you want Serverless to use CAREPULSE_MCP_KEY instead.
# The Bee bridge reads CAREPULSE_MCP_KEY; use the same gateway key for that client.

# Optional Bedrock configuration. Leave both blank for deterministic voice copy.
# Set both values together to enable the model; the model ID is an AWS model/profile ID.
# Include every exact model/profile ARN required for the selected model.
BEDROCK_MODEL_ID=
BEDROCK_RESOURCE_ARNS=
# Optional milliseconds; runtime clamps finite values to 50-2000, default 1200.
VOICE_TIMEOUT_MS=1200
# Previous setting: REQUIRE_BEDROCK=true. It is deprecated and not read.
# Deterministic voice responses remain available when Bedrock is not configured.

# Demo member defaults retained from serverless.yml. Time zone must be an IANA ID.
DEFAULT_MEMBER_NAME=Elena
DEFAULT_CAREGIVER_NAME=Laura
DEFAULT_TIME_ZONE=America/Mexico_City
DEMO_OWNER_ID=
# Optional: a number greater than 0 and at most 24, only for DEMO_OWNER_ID.
DEFAULT_BASELINE_SLEEP_HOURS=
# Previous baseline default: 8.0 hours.
# For an explicit demo only, set DEMO_OWNER_ID and DEFAULT_BASELINE_SLEEP_HOURS=8.0.
# Non-demo members require a verified personal baseline in their care context.

# Optional gateway and operational settings. Origins are comma-separated browser origins;
# an empty list rejects browser requests that include an Origin header.
MCP_ALLOWED_ORIGINS=
OPERATIONS_ALARM_TOPIC_ARN=

# Optional local Bee consent duration: positive number of days, default 30.
# The current Serverless stack does not forward this value to Lambda.
# BEE_CONSENT_DAYS=30

# Alexa+ add-on OAuth (see docs/alexa-plus-addon.md). Set after alexa-ai configure-account-linking prints them.
# ALEXA_REDIRECT_URIS=https://<alexa-redirect-1>,https://<alexa-redirect-2>
# Only with a custom domain; must match the add-on manifest URL exactly.
# MCP_RESOURCE_URL=https://<custom-domain>/mcp
# OAUTH_ISSUER_URL=https://<custom-domain>

# CloudFormation manages these values; record the outputs below after deployment.
# Do not override them through .env when using the managed Serverless stack.
# CARE_TABLE_NAME=carepulse-dev-care-state
# SNS_TOPIC_ARN=<CaregiverAlertsTopicArn output>
# ALEXA_LAMBDA_ARN=<AlexaLambdaArn output>
# CAREPULSE_MCP_URL=<McpEndpoint output>
# Previous SNS encryption: alias/aws/sns. The stack now manages NotificationKey.

# Unchanged infrastructure defaults (defined in serverless.yml):
# service=carepulse-mvp, stage=dev, runtime=nodejs22.x, architecture=arm64
# memorySize=512, timeout=15, logRetentionInDays=14
# deploymentMethod=direct, versionFunctions=false
